{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BauPlanIO",
  "version": "0.1.1",
  "identifier": "io.pixelcraft.bauprojektio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BauPlanIO",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "PixelCraftIO",
    "copyright": "© PixelCraftIO",
    "category": "Productivity",
    "shortDescription": "Bauanträge erstellen, berechnen und einreichen",
    "longDescription": "Projektmanagement- und Bauantrags-Software für Architekten: GRZ/GFZ/BMZ, Abstandsflächen nach Landesbauordnung, amtliche Formulare, CAD-Viewer und XBau-Export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../lbo-rules/": "lbo-rules/",
      "../../../formulare/": "formulare/",
      "../../../codelisten/": "codelisten/",
      "../../../beispiele/Beispielprojekt-EFH-Mustermann.zip": "beispiele/Beispielprojekt-EFH-Mustermann.zip"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "de-DE",
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "misc"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/PixelCraftIO/BauProjektIO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
