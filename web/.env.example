# Öffentliche Adresse der Seite (ohne abschließenden Schrägstrich).
BETTER_AUTH_URL=http://localhost:3000
# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Konto, das beim Start angelegt bzw. aktualisiert wird.
BAUPLANIO_ADMIN_EMAIL=
BAUPLANIO_ADMIN_PASSWORT=
BAUPLANIO_ADMIN_NAME=Daniel
# Ablage der Benutzerdatenbank (SQLite). Im Container: /data/auth.sqlite
BAUPLANIO_DATENBANK=./daten/auth.sqlite
# Ordner des Benutzerhandbuchs; Standard ist ../docs/handbuch/benutzerhandbuch
# BAUPLANIO_HANDBUCH=
